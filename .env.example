# Copy to .env.local (never commit real values). On Vercel set these in Project > Settings > Environment Variables.
ANTHROPIC_API_KEY=
DATABASE_URL=
# Optional: override the model used for narratives (default is set in packages/narrative/src/llm.ts)
ANTHROPIC_MODEL=
# Enables write endpoints (approvals). Leave empty to keep writes disabled. Use a long random string.
API_WRITE_TOKEN=
